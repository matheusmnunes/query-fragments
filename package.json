{
  "name": "query-fragments",
  "version": "0.1.0",
  "description": "A fluent and type-safe query builder built on top of sql-string-ts.",
  "license": "MIT",
  "author": "Matheus Nunes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seu-usuario/query-fragments.git"
  },
  "bugs": {
    "url": "https://github.com/seu-usuario/query-fragments/issues"
  },
  "homepage": "https://github.com/seu-usuario/query-fragments#readme",
  "keywords": [
    "sql",
    "query",
    "query-builder",
    "typescript",
    "sql-fragments",
    "postgres",
    "postgresql",
    "mysql",
    "mysql2"
  ],
  "peerDependencies": {
    "sql-string-ts": "^0.1.3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "sql-string-ts": "^0.1.3",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}